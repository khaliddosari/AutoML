# Backend origin the /api/backend/* proxy forwards to (see next.config.ts).
# Local dev: the local FastAPI server.
# On Vercel: set this to the Render backend's public URL, e.g.
#   https://modelforge-backend-wy4n.onrender.com
BACKEND_URL=http://localhost:8000

# Canonical site URL used for metadata / Open Graph tags.
# On Vercel: set to the production domain, e.g. https://namtheg.vercel.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
